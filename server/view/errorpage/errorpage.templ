package errorpage

import (
	"fmt"

	"server/types"
	"server/view"
)

// ErrorData describes a single error page to render.
type ErrorData struct {
	Code       int
	PageTitle  string
	Title      string
	Message    string
	BadgeClass string
}

// ErrorPage renders a full-page error message. It replaces the previous
// per-status templates (403, 404, 500) with one parameterized component.
templ ErrorPage(page string, fromProtected bool, username string, data types.PageData, err ErrorData) {
	@view.Index(page, fromProtected, username, data) {
		<section class="flex flex-col items-center justify-center min-h-[80vh] gap-6 px-4">
			<div class="items-center justify-center flex flex-col gap-4">
				<h1 class="text-9xl font-extrabold text-base-content/20 tracking-widest">
					{ fmt.Sprintf("%d", err.Code) }
				</h1>
				<h2 class={ err.BadgeClass + " px-3 py-1 text-sm rounded-lg rotate-12 absolute shadow-lg" }>
					{ err.Title }
				</h2>
			</div>
			<p class="text-sm text-center md:text-base text-base-content/70 max-w-md">
				{ err.Message }
			</p>
			if fromProtected {
				<a href="/u/home" class="btn btn-primary btn-outline mt-2">Go Home</a>
			} else {
				<a href="/" class="btn btn-primary btn-outline mt-2">Go Home</a>
			}
		</section>
	}
}
