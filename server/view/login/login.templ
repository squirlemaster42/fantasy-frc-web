package login

import "fmt"
import "server/view"
import "server/view/partials"
import "server/types"

templ LoginIndex(fromProtected bool, errorMessage string, minPasswordLength int, csrfToken string) {
    <div id="login-box">
        @AuthCard("Sign In", "Enter your credentials to continue", "Don't have an account? ", "/register", "Create one here") {
            if errorMessage != "" {
                @partials.AlertBanner(errorMessage, "error")
            }

            <form
                hx-swap="outerHTML transition:true"
                hx-post="/login"
                hx-target="#login-box"
                action=""
                method="post"
                class="space-y-6"
            >
                @partials.CSRFInput(csrfToken)
                <!-- Username Field -->
                <div>
                    <label class="block text-sm font-medium text-base-content/80 mb-2">Username</label>
                    <div class="relative">
                        <input
                            class="w-full bg-base-300 border border-base-300 rounded-lg pl-10 pr-4 py-3 text-base-content placeholder-base-content/50 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent disabled:opacity-50 disabled:cursor-not-allowed"
                            type="text"
                            name="username"
                            required
                            hx-preserve
                            autofocus
                            disabled?={ fromProtected }
                            if fromProtected {
                                value="disabled"
                            }
                        />
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            @partials.IconUser("size-5 text-base-content/60")
                        </div>
                    </div>
                </div>

                <!-- Password Field -->
                <div>
                    <label class="block text-sm font-medium text-base-content/80 mb-2">Password</label>
                    <div class="relative">
                        <input
                            class="w-full bg-base-300 border border-base-300 rounded-lg pl-10 pr-4 py-3 text-base-content placeholder-base-content/50 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent disabled:opacity-50 disabled:cursor-not-allowed"
                            type="password"
                            name="password"
                            required
                            minlength={ fmt.Sprintf("%d", minPasswordLength) }
                            disabled?={ fromProtected }
                            if fromProtected {
                                value="disabled"
                            }
                        />
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            @partials.IconLock("size-5 text-base-content/60")
                        </div>
                    </div>
                </div>

                <!-- Sign In Button -->
                <div x-data="{ loading: false }" @htmx:before-request="loading = true" @htmx:after-request="loading = false" @htmx:response-error="loading = false">
                    <button
                        type="submit"
                        disabled?={ fromProtected }
                        hx-disabled-elt="this"
                        class="w-full btn btn-primary font-semibold py-3 px-4 rounded-lg transition-all duration-200 hover:scale-105 disabled:hover:scale-100 disabled:cursor-not-allowed flex items-center justify-center gap-2"
                    >
                        <span x-show="!loading" class="flex items-center justify-center gap-2">
                            Sign In
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                            </svg>
                        </span>
                        <span x-show="loading" x-cloak class="flex items-center justify-center gap-2">
                            <svg class="animate-spin size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            Signing In...
                        </span>
                    </button>
                </div>
            </form>
        }
    </div>
}

templ Login(page string, fromProtected bool, cmp templ.Component) {
    @view.Index(page, fromProtected, "", types.NewPageData(0, "", false)) {
        @cmp
    }
}
