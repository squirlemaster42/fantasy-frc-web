package login

import "fmt"
import "server/view"
import "server/view/partials"
import "server/types"

templ RegisterIndex(fromProtected bool, errorMessage string, minPasswordLength int, csrfToken string) {
    <div id="register-box">
        @AuthCard("Create Account", "Join the FRC Fantasy League", "Already have an account? ", "/login", "Sign in here") {
            if errorMessage != "" {
                @partials.AlertBanner(errorMessage, "error")
            }

            <form
                hx-swap="outerHTML transition:true"
                hx-post="/register"
                hx-target="#register-box"
                action=""
                method="post"
                class="space-y-6"
            >
                @partials.CSRFInput(csrfToken)
                <!-- Username Field -->
                <div>
                    <label class="block text-sm font-medium text-base-content/80 mb-2">Username</label>
                    <div class="relative">
                        <input
                            class="w-full bg-base-300 border border-base-300 rounded-lg pl-10 pr-4 py-3 text-base-content placeholder-base-content/50 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent disabled:opacity-50 disabled:cursor-not-allowed"
                            type="text"
                            name="username"
                            required
                            autofocus
                            disabled?={ fromProtected }
                            if fromProtected {
                                value="disabled"
                            }
                        />
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            @partials.IconUser("size-5 text-base-content/60")
                        </div>
                    </div>
                </div>

                <!-- Password Field -->
                <div>
                    <label class="block text-sm font-medium text-base-content/80 mb-2">Password</label>
                    <div class="relative">
                        <input
                            class="w-full bg-base-300 border border-base-300 rounded-lg pl-10 pr-4 py-3 text-base-content placeholder-base-content/50 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent disabled:opacity-50 disabled:cursor-not-allowed"
                            type="password"
                            name="password"
                            required
                            minlength={ fmt.Sprintf("%d", minPasswordLength) }
                            disabled?={ fromProtected }
                            if fromProtected {
                                value="disabled"
                            }
                        />
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            @partials.IconLock("size-5 text-base-content/60")
                        </div>
                    </div>
                </div>

                <!-- Confirm Password Field -->
                <div>
                    <label class="block text-sm font-medium text-base-content/80 mb-2">Confirm Password</label>
                    <div class="relative">
                        <input
                            class="w-full bg-base-300 border border-base-300 rounded-lg pl-10 pr-4 py-3 text-base-content placeholder-base-content/50 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent disabled:opacity-50 disabled:cursor-not-allowed"
                            type="password"
                            name="confirmPassword"
                            required
                            minlength={ fmt.Sprintf("%d", minPasswordLength) }
                            maxlength="64"
                            disabled?={ fromProtected }
                            if fromProtected {
                                value="disabled"
                            }
                        />
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            @partials.IconCheck("size-5 text-base-content/60")
                        </div>
                    </div>
                </div>

                <!-- Register Button -->
                <div x-data="{ loading: false }" @htmx:before-request="loading = true" @htmx:after-request="loading = false" @htmx:response-error="loading = false">
                    <button
                        type="submit"
                        disabled?={ fromProtected }
                        hx-disabled-elt="this"
                        class="w-full btn btn-success font-semibold py-3 px-4 rounded-lg transition-all duration-200 hover:scale-105 disabled:hover:scale-100 disabled:cursor-not-allowed flex items-center justify-center gap-2"
                    >
                        <span x-show="!loading" class="flex items-center justify-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
                            </svg>
                            Create Account
                        </span>
                        <span x-show="loading" x-cloak class="flex items-center justify-center gap-2">
                            <svg class="animate-spin size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            Creating...
                        </span>
                    </button>
                </div>
            </form>
        }
    </div>
}

templ Register(page string, fromProtected bool, cmp templ.Component) {
    @view.Index(page, fromProtected, "", types.NewPageData(0, "", false)) {
        @cmp
    }
}
