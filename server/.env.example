# Database Configuration
DB_IP=localhost
DB_NAME=fantasy_frc
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Server Configuration
SERVER_PORT=3000

# The Blue Alliance API Token
TBA_TOKEN=your_tba_token_here

# The Blue Alliance Webhook Secret
TBA_WEBHOOK_SECRET=your_webhook_secret_here

# Metrics Collection Secret
METRIC_SECRET=your_metric_secret_here

# CSRF Protection Secret (required). Should be a long random string
CSRF_SECRET=your_csrf_secret_here_change_me

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_RESOURCE_ATTRIBUTES=service.name=fantasy-frc-web

# Secure http cookies. False for dev, true for prod. Defaults to true
SECURE_HTTP_COOKIE=false

# Trust proxy / origin settings. Only enable TRUST_PROXY when behind a trusted proxy.
TRUST_PROXY=false
ALLOWED_ORIGIN=

# Password Policy
MIN_PASSWORD_LENGTH=12
MIN_USERNAME_LENGTH=3
MAX_USERNAME_LENGTH=32
USERNAME_ALLOWED_SPECIAL_CHARS=_-

# bcrypt cost factor for password hashing (default: 14)
BCRYPT_COST=14

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_POSTS_PER_MINUTE=100
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_REGISTER_ATTEMPTS=3
RATE_LIMIT_AUTH_WINDOW=15m

# Redis Configuration (required for avatars and rate limiting)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_RATE_LIMIT_DB=1
REDIS_AVATAR_DB=2

# Pick window configuration file (default: ../config/pick-windows.json relative to server/)
PICK_WINDOWS_CONFIG_FILE=../config/pick-windows.json

# TBA webhook verification file (default: ./webhookSecret.txt relative to server/)
TBA_WEBHOOK_SECRET_FILE=./webhookSecret.txt

# Championship event codes (default: arc,cur,dal,gal,hop,joh,mil,new,cmptx)
TBA_EVENT_CODES=arc,cur,dal,gal,hop,joh,mil,new,cmptx

# Many additional tuning variables are available. See AGENTS.md for the full list.
